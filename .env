APP_NAME=Document OCR

HOST=0.0.0.0
PORT=8000

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
CACHE_DIR=data/cache
MODEL_DIR=models
LOG_DIR=data/logs

DYNAMIC_FILE_RETENTION_DAYS=1
LOG_RETENTION_DAYS=3
CLEANUP_INTERVAL_SECONDS=3600

# true: use models/my_bank_card_det first; false: use official PaddleX models
OCR_USE_FINE_TUNED_MODEL=false

# CPU production uses the lightweight official detection and recognition models.
OCR_MODEL_PROFILE=mobile
OCR_DEVICE=cpu
OCR_ENABLE_MKLDNN=true
OCR_CPU_THREADS=8

# PaddleX's official OCR pipeline batches text boxes. This is especially
# important for business licenses and invoices with many text lines.
OCR_TEXT_RECOGNITION_BATCH_SIZE=6

# Keep the orientation model loaded, but only run it when auto_orientation=true.
OCR_ENABLE_DOC_ORIENTATION_MODEL=true
OCR_USE_DOC_ORIENTATION=true
OCR_USE_DOC_UNWARPING=false

# Debug images are encoded as JPEG in a background worker after inference.
OCR_SAVE_PREPROCESSED_IMAGE=true
OCR_PREPROCESSED_JPEG_QUALITY=90

# Cache raw OCR results by image hash and inference settings for one day.
OCR_CACHE_ENABLED=true
OCR_CACHE_VERSION=1

# Queue PaddleX calls without blocking FastAPI. The pipeline is used by one thread at a time.
OCR_MAX_CONCURRENT_REQUESTS=1
