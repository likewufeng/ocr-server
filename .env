APP_NAME=Document OCR

HOST=0.0.0.0
PORT=8000

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
MODEL_DIR=models
LOG_DIR=data/logs

DYNAMIC_FILE_RETENTION_DAYS=1
