# ============================================================
# OCR Server 配置
# 修改本文件后需要重启服务；Docker 生产环境需要重新创建容器。
# ============================================================

# ---------- 服务基础配置 ----------
# 本地通过 python start.py 启动时，Uvicorn 的监听地址和端口。
# Swagger 文档：http://127.0.0.1:8000/docs
APP_NAME=Document OCR
HOST=0.0.0.0
PORT=8000
# Docker 对外暴露的宿主机端口；容器内部始终监听 8000。
# Docker Swagger 文档：http://127.0.0.1:18081/docs
OCR_HOST_PORT=18081
# 多实例监控标识；本地可不配置，默认使用主机名。Compose 扩容文件会覆盖该值。
INSTANCE_NAME=local
# 是否启用内存指标采集，并开放 /metrics 和 /metrics/json。
METRICS_ENABLED=true

# ---------- 动态数据目录 ----------
# 以下相对路径均以项目根目录为基准。
# uploads：调用方上传的原文件，按 request_id 分目录保存。
# outputs：OCR 结果、解析结果及预处理排查图片。
# cache：按图片 SHA-256 保存的 OCR 缓存。
# models：自训练模型目录。
# logs：服务运行日志。
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
CACHE_DIR=data/cache
MODEL_DIR=models
LOG_DIR=data/logs
# 银行名称别名、卡种文案、BIN/IIN 规则的数据文件。可在部署环境挂载完整授权 IIN 数据库后修改此路径。
BANK_CARD_CATALOG_FILE=app/resources/bank_card/catalog.json
BANK_CARD_IIN_FILE=app/resources/bank_card/iin_catalog.json

# ---------- 自动清理 ----------
# 上传文件、输出文件和 OCR 缓存保留 1 天。
DYNAMIC_FILE_RETENTION_DAYS=1
# 日志保留 3 天。
LOG_RETENTION_DAYS=3
# 每 3600 秒（1 小时）检查一次过期文件。
CLEANUP_INTERVAL_SECONDS=3600

# ---------- OCR 模型选择 ----------
# true：优先使用 models/my_bank_card_det 自训练“文字检测”模型；
#       文字识别仍使用下面 OCR_MODEL_PROFILE 指定的官方识别模型。
# false：文字检测和文字识别都使用 PaddleX 官方模型。
OCR_USE_FINE_TUNED_MODEL=false

# mobile：轻量模型，CPU 服务器推荐，速度快、内存占用低。
# server：高精度模型，GPU 服务器推荐；无 GPU 时可能非常慢。
# Official model family. The service now uses PP-OCRv6 by default.
OCR_MODEL_VERSION=v6
# mobile maps to PP-OCRv6_tiny for CPU; server maps to PP-OCRv6_medium.
OCR_MODEL_PROFILE=medium
# auto: Windows uses paddle_dynamic; Linux/Docker uses paddle_static.
OCR_MODEL_ENGINE=auto

# cpu：当前 CPU 镜像使用该值。
# gpu:0：使用第 1 张 GPU；必须安装 GPU 版 PaddlePaddle、CUDA、cuDNN，
#        并给 Docker 容器分配 GPU，仅修改此变量不能把 CPU 镜像变成 GPU 镜像。
OCR_DEVICE=gpu:0
# paddle：生产稳定后端，CPU 下配合 MKLDNN；openvino：仅用于隔离的对照实验。
# OpenVINO 需要额外安装 PaddleX HPIP 和 Paddle2ONNX，不要直接在生产环境切换。
OCR_INFERENCE_BACKEND=paddle

# ---------- CPU 推理加速 ----------
# MKLDNN 只对 CPU 推理有效；GPU 模式下会被忽略。
OCR_ENABLE_MKLDNN=true
# Paddle 每次推理使用的 CPU 线程数，建议不超过服务器可用 CPU 核数。
OCR_CPU_THREADS=8

# ---------- 文字识别批处理与并发 ----------
# 一次批量识别多少个文字框。营业执照、发票文字较多时收益明显。
# CPU 当前实测推荐 6；GPU 可根据显存测试 16 或 32。
OCR_TEXT_RECOGNITION_BATCH_SIZE=6
# 身份证正面模糊照片的专用 OCR 置信度门槛；仅影响 id_front，默认 0.5。
OCR_ID_FRONT_MIN_SCORE=0.5
# 当前服务共享一个 PaddleX pipeline，建议保持 1，避免线程安全和资源争抢问题。
# 高并发场景优先部署多个容器实例，不要直接盲目调大该值。
OCR_MAX_CONCURRENT_REQUESTS=1

# ---------- 授权委托书 ----------
# /authorization/letter/parse-ocr 将 PDF 页面渲染为图片时使用的 DPI。
# 180 适合 GPU 环境下兼顾正文小字、身份证附件清晰度和响应时间。
AUTHORIZATION_RENDER_DPI=180
# PDF 页面原生文本少于该字符数时，才把整页视为扫描页并调用 OCR。
AUTHORIZATION_NATIVE_TEXT_MIN_CHARS=80
# 授权书扫描件与身份证复印件的最低 OCR 置信度。
AUTHORIZATION_OCR_MIN_SCORE=0.35

# ---------- 图片方向与形变预处理 ----------
# 是否加载方向检测模型。保持 true 才能让接口参数 auto_orientation=true 生效。
OCR_ENABLE_DOC_ORIENTATION_MODEL=true
# 调用 /ocr 时不传 auto_orientation 的默认行为。
# true 更稳妥，适合手机拍摄等图片方向不可控的生产场景；
# 调用方确认方向正确时，可对单次请求传 auto_orientation=false 来提速。
OCR_USE_DOC_ORIENTATION=true
# UVDoc 文档展平，适合弯曲、透视严重的文档，但 CPU 上耗时明显，默认关闭。
OCR_USE_DOC_UNWARPING=false
# 仅身份证正面使用 UVDoc 展平，改善透视/轻微弯曲；CPU 会增加耗时，建议先做 A/B
OCR_ID_FRONT_USE_DOC_UNWARPING=false

# 仅姓名/生日为空时，对该字段小区域做一次局部 OCR；正常请求不增加推理。
OCR_ID_FRONT_FIELD_ROI_RETRY_ENABLED=false
# 局部区域放大倍率，范围 1.0-4.0。
OCR_ID_FRONT_FIELD_ROI_SCALE=3.0
OCR_ID_FRONT_FIELD_ROI_MIN_SCORE=0.5

# 营业执照经营范围为空或过短时，可裁剪该区域做一次局部 OCR。先通过金标 A/B 后再启用。
OCR_BUSINESS_SCOPE_ROI_RETRY_ENABLED=false
# 经营范围少于该字符数才可能触发二次识别。
OCR_BUSINESS_SCOPE_ROI_MIN_CHARS=48
# 局部图最大放大倍率和最长边上限，避免 CPU 生产环境内存、耗时失控。
OCR_BUSINESS_SCOPE_ROI_SCALE=1.5
OCR_BUSINESS_SCOPE_ROI_MAX_SIDE=2200
OCR_BUSINESS_SCOPE_ROI_MIN_SCORE=0.5

# 营业执照的统一社会信用代码、名称、法定代表人为空时，按标签位置局部补识别。
OCR_BUSINESS_FIELD_ROI_RETRY_ENABLED=true
OCR_BUSINESS_FIELD_ROI_SCALE=3.0
OCR_BUSINESS_FIELD_ROI_MIN_SCORE=0.5

# 营业执照文字检测最长边。960 更快；1280 可改善小字号经营范围，但会增加 CPU 耗时。
OCR_BUSINESS_LICENSE_DETECTION_SIDE_LIMIT=960

# ---------- 银行卡专用区域定位 ----------
# false：继续仅用整图 PP-OCR（默认，兼容现有部署）。
# true：加载下方 ONNX 模型定位卡号/有效期区域，再对区域补做 OCR；仅影响显式
# document_type=bank_card 的请求。启用前必须先执行导出脚本生成模型并完成 A/B。
OCR_BANK_CARD_ROI_ENABLED=true
OCR_BANK_CARD_ROI_MODEL_FILE=models/bank_card_roi/yolo_best.onnx
# YOLO ONNX 的正方形输入边长；640 是 CreditCard-OCR 原模型的常用导出尺寸。
OCR_BANK_CARD_ROI_INPUT_SIZE=640
# 区域检测最低置信度和 NMS 阈值。降低 confidence 可提高召回，但可能裁到错误区域。
OCR_BANK_CARD_ROI_CONFIDENCE=0.45
OCR_BANK_CARD_ROI_NMS=0.45
# 裁剪框外扩比例，避免凸印卡号或有效期边缘被截断。
OCR_BANK_CARD_ROI_PADDING_RATIO=0.08
# 局部 OCR 文字的最低保留分数。银行卡数字易受反光影响，低于全局默认值。
OCR_BANK_CARD_ROI_MIN_SCORE=0.35

# 身份证正面低质量图片的条件二次识别；首轮结果完整时不会重复推理。
OCR_ID_FRONT_QUALITY_RETRY_ENABLED=false
# 首轮缺少姓名、性别、民族、生日、住址或身份证号证据时触发重试。
OCR_ID_FRONT_RETRY_ON_INCOMPLETE=true
# 重试图片放大倍率，范围 1.0-2.0；CPU 生产环境建议 1.5。
OCR_ID_FRONT_RETRY_SCALE=1.5
# 防止超大原图放大后占用过多内存。
OCR_ID_FRONT_RETRY_MAX_SIDE=2400
# 以下为低质量检测阈值，命中任意一项才会进入候选重试。
OCR_ID_FRONT_RETRY_BLUR_THRESHOLD=45
OCR_ID_FRONT_RETRY_MIN_SIDE=300
OCR_ID_FRONT_RETRY_DARK_MEAN=35
OCR_ID_FRONT_RETRY_BRIGHT_MEAN=235
OCR_ID_FRONT_RETRY_CLIPPED_RATIO=0.35

# ---------- 排查图片 ----------
# 后台保存平台预处理后的图片，不阻塞接口响应。
# 仅在本次请求实际执行方向检测或 UVDoc 时生成 preprocessed_platform.jpg。
OCR_SAVE_PREPROCESSED_IMAGE=true
# JPEG 质量范围 1-100；90 适合排查且文件体积较小。
OCR_PREPROCESSED_JPEG_QUALITY=90

# ---------- OCR 结果缓存 ----------
# 相同图片和相同推理参数直接复用 OCR 原始结果，每次请求仍生成独立 request_id。
OCR_CACHE_ENABLED=true
# 修改模型、预处理算法后如需立即废弃旧缓存，将版本号加 1。
OCR_CACHE_VERSION=7
